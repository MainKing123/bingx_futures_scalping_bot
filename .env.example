# Public data, paper trading and backtests do not require keys.
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_BASE_URL=https://api.mexc.com
MEXC_RECEIVE_WINDOW=10
TRADING_SYMBOLS=["ZEC_USDT","SOL_USDT","DOGE_USDT","XRP_USDT","ETH_USDT"]
PAIR_SELECTION=dynamic
PAIR_COUNT=5
LARGE_CAP_TOP_N=20
MIN_PAIR_VOLUME_USD=50000000
UNIVERSE_REFRESH_SECONDS=3600
VOLIUM_MODE=intraday
VOLIUM_SWING_CONTEXT=1d
VOLIUM_SWING_LOOKBACK=2
VOLIUM_CONTEXT_LOOKBACK=80
VOLIUM_SWEEP_MAX_AGE_BARS=12
VOLIUM_REACTION_MAX_BARS=3
VOLIUM_MIN_BODY_RATIO=0.6
VOLIUM_STOP_BUFFER_BPS=2
VOLIUM_SCALP_STOP_BUFFER_BPS=10
VOLIUM_REQUIRE_DAILY_ORIGIN_SWEEP=true
VOLIUM_ACTIVE_TREND_MIN_ATR=1
VOLIUM_SESSION_ENABLED=true
# 18:00 afternoon end is a documented interpretation of the video.
VOLIUM_SESSIONS_UTC3=[["10:00","12:00"],["16:30","18:00"]]
# Optional DST interpretation; indicator's protected code does not expose exact crypto defaults.
VOLIUM_SESSION_CLOCK=fixed_utc3
VOLIUM_MARKET_SESSIONS=[["Europe/London","08:00","10:00"],["America/New_York","09:30","11:00"]]
SCAN_INTERVAL_SECONDS=30
RISK_PER_TRADE_PERCENT=0.5
DAILY_LOSS_LIMIT_PERCENT=2
MAX_OPEN_SETUPS=3
ACCOUNT_BALANCE_USDT=1000
DEFAULT_LEVERAGE=3
PENDING_ORDER_MAX_AGE_MINUTES=30
PAPER_FEE_BPS=5
PAPER_SLIPPAGE_BPS=2
AUTO_EXECUTION=false
HOST=127.0.0.1
PORT=8000
